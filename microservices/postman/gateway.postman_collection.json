{
  "info": {
    "name": "gateway-service (port 8888)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8888"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Identity - Register qua Gateway",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/identity/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"bao\",\n  \"password\": \"123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 hoặc 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Identity - Login qua Gateway",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/identity/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"bao\",\n  \"password\": \"123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Có JWT', () => pm.expect(pm.response.json().accessToken.split('.')).to.have.lengthOf(3));",
              "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Identity - Login sai qua Gateway",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/identity/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"bao\",\n  \"password\": \"wrong\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Product - Danh sách qua Gateway",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{gateway}}/product/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Có 3 sản phẩm', () => pm.expect(pm.response.json()).to.have.lengthOf(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "Product - Chi tiết qua Gateway",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{gateway}}/product/api/products/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Không khớp route -> 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gateway}}/unknown/api/x"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}