{
  "info": {
    "name": "identity-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "oldRefreshToken",
      "value": ""
    },
    {
      "key": "logoutAccessToken",
      "value": ""
    },
    {
      "key": "logoutRefreshToken",
      "value": ""
    },
    {
      "key": "jti",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"bao\",\n  \"password\": \"123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 hoặc 409 (đã tồn tại)', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. Register INSTRUCTOR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"thaygiao\",\n  \"password\": \"123456\",\n  \"role\": \"INSTRUCTOR\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 hoặc 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
            ]
          }
        }
      ]
    },
    {
      "name": "1c. Register ADMIN → 400 (không cho tự chọn)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"hacker\",\n  \"password\": \"123456\",\n  \"role\": \"ADMIN\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login - đúng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"bao\",\n  \"password\": \"123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Có accessToken (JWT 3 phần)', () => pm.expect(body.accessToken.split('.')).to.have.lengthOf(3));",
              "pm.test('Có refreshToken (UUID)', () => pm.expect(body.refreshToken).to.match(/^[0-9a-f-]{36}$/));",
              "pm.test('expiresIn = 900s', () => pm.expect(body.expiresIn).to.eql(900));",
              "const payload = JSON.parse(atob(body.accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
              "const header = JSON.parse(atob(body.accessToken.split('.')[0].replace(/-/g,'+').replace(/_/g,'/')));\npm.test('Header alg = HS256', () => pm.expect(header.alg).to.eql('HS256'));",
              "pm.test('Claims: sub, role, jti, exp', () => { pm.expect(payload.sub).to.eql('bao'); pm.expect(payload.role).to.eql('STUDENT'); pm.expect(payload.jti).to.match(/^[0-9a-f-]{36}$/); pm.expect(payload.exp - payload.iat).to.eql(900); });",
              "pm.test('Không có JSESSIONID', () => pm.expect(pm.response.headers.get('Set-Cookie') || '').to.not.include('JSESSIONID'));",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "2b. Login INSTRUCTOR → role = INSTRUCTOR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"thaygiao\",\n  \"password\": \"123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().accessToken;",
              "const p = JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
              "pm.test('role = INSTRUCTOR', () => pm.expect(p.role).to.eql('INSTRUCTOR'));",
              "pm.test('Có jti', () => pm.expect(p.jti).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7.1 Rotation - Bước 2: gửi R1 → nhận B + R2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\": \"{{refreshToken}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const r1 = pm.collectionVariables.get('refreshToken');",
              "pm.test('Có access token mới (B)', () => pm.expect(body.accessToken.split('.')).to.have.lengthOf(3));",
              "pm.test('R2 khác R1', () => pm.expect(body.refreshToken).to.not.eql(r1));",
              "pm.collectionVariables.set('oldRefreshToken', r1);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);",
              "pm.collectionVariables.set('accessToken', body.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "7.2 Rotation - Bước 3: gửi lại R1 → 403",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\": \"{{oldRefreshToken}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "7.3 Rotation - R2 vẫn dùng được (1 lần)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\": \"{{refreshToken}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('refreshToken', pm.response.json().refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "7.4 Refresh - token không tồn tại → 403",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\": \"00000000-0000-0000-0000-000000000000\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "8.0 Logout - Login lấy token mới",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"bao\",\n  \"password\": \"123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().accessToken;",
              "const p = JSON.parse(atob(t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
              "pm.test('Có claim jti (UUID)', () => pm.expect(p.jti).to.match(/^[0-9a-f-]{36}$/));",
              "pm.collectionVariables.set('logoutAccessToken', t);",
              "pm.collectionVariables.set('logoutRefreshToken', pm.response.json().refreshToken);",
              "pm.collectionVariables.set('jti', p.jti);",
              "console.log('Kiểm tra Redis: TTL blacklist:' + p.jti);"
            ]
          }
        }
      ]
    },
    {
      "name": "8.1 Logout - không có token → 401",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "8.2 Logout - với access token → 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{logoutAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{logoutRefreshToken}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "console.log('Redis CLI: KEYS blacklist:*  |  TTL blacklist:' + pm.collectionVariables.get('jti'));"
            ]
          }
        }
      ]
    },
    {
      "name": "8.3 Dùng lại access token đã logout → 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{logoutAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('Bị thu hồi', () => pm.expect(pm.response.json().message).to.include('thu hồi'));"
            ]
          }
        }
      ]
    },
    {
      "name": "8.4 Refresh token của phiên đã logout → 403",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{logoutRefreshToken}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
