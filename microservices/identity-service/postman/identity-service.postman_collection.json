      ]
    },
    {
      "name": "5. Test token (Bài 2)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/test-token?username=bao",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "test-token"
          ],
          "query": [
            {
              "key": "username",
              "value": "bao"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}